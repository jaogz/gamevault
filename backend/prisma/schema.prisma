generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  avatarUrl String?
  coverUrl  String?
  bio       String?
  location  String?
  createdAt DateTime @default(now())
  games     Game[]
  following Follow[] @relation("UserFollowing") // quem este usuário segue
  followers Follow[] @relation("UserFollowers") // quem segue este usuário
}

model Follow {
  followerId  Int
  followingId Int
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model Game {
  id          Int       @id @default(autoincrement())
  name        String
  platform    String?
  status      String?
  genre       String?   // legado: primeiro gênero (mantido por compatibilidade)
  genres      String[]  @default([]) // todos os gêneros do jogo
  fromCatalog Boolean   @default(false) // descrição veio do catálogo (Steam) e não é editável
  description String?   // sobre o jogo em si (o que ele é)
  review      String?   // opinião/consideração pessoal de quem cadastrou
  hoursPlayed Int?
  rating      Int?      // 1 a 5, nota pessoal de quem cadastrou
  favorite    Boolean   @default(false)
  imageUrl    String?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  userId      Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
